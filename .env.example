# ── Connexion TikTok (Login Kit) ───────────────────────────────
# Créez une app sur https://developers.tiktok.com/ ( Login Kit ),
# ajoutez la redirection : http://localhost:3000/auth/tiktok/callback
# (adaptez le port si vous changez PORT)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# ── Canal d'action réel (optionnel) ────────────────────────────
# TikTok n'expose PAS d'endpoint public « retirer un abonné ».
# ACTION_GATEWAY_URL est le point d'entrée d'un canal que VOUS êtes
# en droit d'utiliser (outil interne, passerelle d'un partenaire…).
# Sans lui, l'app tourne en mode démonstration : tout est simulé
# côté serveur, rien n'est réellement envoyé à TikTok.
ACTION_GATEWAY_URL=
ACTION_GATEWAY_SECRET=

# ── Serveur ─────────────────────────────────────────────────────
PORT=3000
